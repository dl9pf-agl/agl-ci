# Single source of truth for every pinned build input. Bump only via reviewed PR.
# debian:trixie-slim multi-arch index digest (resolved 2026-10-22, unchanged)
BASE_DIGEST=sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
# snapshot.debian.org timestamp all apt packages are installed from (20261022 includes ca-certificates 20250419+deb13u1, DSA-6572-1)
SNAPSHOT=20261022T000000Z
# GitHub Actions runner release (sha256 of the tarball verified at build)
RUNNER_VERSION=2.338.2
RUNNER_SHA256=baebf204307bac6193480852732f0aba2ae97b6c5597c244f4d5558390147c40
# docker CLI (client only) from the static release; replaces the Debian docker-cli package, whose Go standard library is old.
# Docker publishes no checksum file: the sha256 was taken on first download (2026-10-28) and is checked at every build.
DOCKER_CLI_VERSION=29.9.2
DOCKER_CLI_SHA256=9ac225999fd5e863f7694c728ef23d480616b1e5639328fa309befd4243d69eb
# BuildKit used by buildx (docker-container driver), pinned by digest
BUILDKIT_IMAGE=moby/buildkit:v0.34.1@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c
# cosign release installed by sigstore/cosign-installer
COSIGN_RELEASE=v2.6.5
# grype (CVE scanner) release + sha256 of grype_<ver>_linux_amd64.tar.gz
GRYPE_VERSION=0.121.0
GRYPE_SHA256=64e07133d3486115de647a66581461dccf5c732748a0a3119077395565f15519
# Lint/security tools (scripts/install-lint-tools.sh). sha256 of the release artifact.
# actionlint hash matches the upstream checksum file; zizmor and shellcheck publish none (hash taken on first download).
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ZIZMOR_VERSION=1.31.1
ZIZMOR_SHA256=d185f726bdaf92df78273217dfdd24ebcd6b0ef48cf3ce776ff5762b6e138c99
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
# syft (SBOM generator) release + sha256 of syft_<ver>_linux_amd64.tar.gz
SYFT_VERSION=1.55.0
SYFT_SHA256=bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d
# cosign binary for hosts without the workflow installer (kit/deploy.sh)
COSIGN_LINUX_AMD64_SHA256=c3b4f5410e608af03a5eb0aaac84a4313d8da131248e08ff1759ac70c79d1644
# docker:dind sidecar used by the kit (index digest of docker.io/library/docker:dind, 2026-10-22)
DIND_IMAGE=docker.io/library/docker@sha256:9e79b879b177fbd72c34376a3dd3d91747da5db49e1f560f76aea59561471977
