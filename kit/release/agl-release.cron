# /etc/cron.d/agl-release on the DOWNLOAD SERVER. Example: adjust the path of the agl-ci checkout and the user.
# Every 5 minutes: pull the staging area of the build host, update the agl-ucb checkout (the engineers' signatures are commits
# there), verify and promote. Daily: remove promoted staging copies. One flock for both. Log: /var/log/agl-release.log.
# The pull sees staging/release/<branch>/<version> only when the release job has renamed its .partial directory (finalize).
# To switch promotion to manual, put RELEASE_PROMOTE=manual in /etc/agl-release/promote.env; then run kit/release/promote.sh <branch> <version> by hand.
*/5 * * * * root flock -n /run/agl-release.lock /root/agl-ci/kit/release/run.sh
17 3 * * * root flock -n /run/agl-release.lock /root/agl-ci/kit/release/run.sh cleanup
