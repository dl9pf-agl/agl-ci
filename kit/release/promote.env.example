# /etc/agl-release/promote.env on the download server (read by the cron entry; plain KEY=value, exported by the cron line's `.`)
export RELEASE_ROOT=/srv/mirror
export RELEASE_UCB_DIR=/srv/agl-ucb          # read-only clone of agl-ucb
export RELEASE_KEYS_DIR=/opt/agl-ci/keys/release
export RELEASE_PROMOTE=auto                  # or manual
export RELEASE_MIN_SIGNATURES=1
export RELEASE_REPO=dl9pf-agl/agl-ucb
export BUILD_RSYNC=rsync://BUILDER-PRIVATE-ADDRESS/agl/   # the build host's rsync daemon (kit/mirror/rsyncd.sh); no real address in the repo
