# CVE gate policy. Two independent bars; each: none | low | medium | high | critical
#   none = report only, never fail.
# BUILD  bar: images.yml, before anything is published (fail early).
# RELEASE bar: release.yml audit job, only catches what appeared between build and release.
BUILD_FAIL_ON=none
RELEASE_FAIL_ON=none
# true = only count findings that have a fix available (unfixed distro CVEs do not block)
BUILD_ONLY_FIXED=true
RELEASE_ONLY_FIXED=true
