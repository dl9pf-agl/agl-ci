# Project identity: the only place that names this project. Adopters change this file (and pins/policy), not the scripts.
PROJECT_REPO=dl9pf-agl/agl-ci
REGISTRY=ghcr.io
IMAGES="builder runner"
# Who may sign CI images (cosign keyless identity). GitHub values; other forges set their own issuer/regexp.
OIDC_ISSUER=https://token.actions.githubusercontent.com
CI_IDENTITY_REGEXP='^https://github.com/dl9pf-agl/agl-ci/\.github/workflows/images\.yml@refs/(heads/main|tags/v[0-9].*)$'
